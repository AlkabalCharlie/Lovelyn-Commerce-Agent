# Supabase database credentials (never commit the real .env)
SUPABASE_USERNAME=postgres.your-project-id
SUPABASE_HOST=aws-0-us-east-1.pooler.supabase.com
SUPABASE_PASSWORD=your-database-password
# Dashboard login password (choose a strong one)
APP_PASSWORD=choose-a-strong-dashboard-password
# Optional. Leave unset to keep full certificate verification.
# LOVELYN_SSL_VERIFY=false