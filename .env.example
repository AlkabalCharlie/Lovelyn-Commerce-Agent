# Supabase (Dashboard -> Project Settings)
SUPABASE_USERNAME=postgres.your-project-id
SUPABASE_HOST=aws-0-us-east-1.pooler.supabase.com
SUPABASE_PASSWORD=your-database-password

# Dashboard login password (choose a strong one)
APP_PASSWORD=choose-a-strong-dashboard-password

# Optional. Leave unset to keep full certificate verification
# LOVELYN_SSL_VERIFY=false

# Public anon key (Dashboard -> API keys -> publishable/anonymous PUBLIC key)
SUPABASE_ANON_KEY=your-public-anon-key

# Distribution keys (all free tiers)
DEVTO_API_KEY=your-devto-key
HASHNODE_PAT=your-hashnode-token
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=your-bluesky-app-password